# API
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Local folders. For Windows use absolute paths, e.g. D:\\PhotoArchive
DATA_DIR=./data
ARCHIVE_ROOT=./data/archive
QUARANTINE_FOLDER=./data/quarantine
THUMBNAILS_FOLDER=./data/thumbnails

# Optional local services. Leave empty to use built-in SQLite-vector and in-memory queue fallbacks.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=photoarchive
VECTOR_SIZE=512
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=photoarchive

# AI. DirectML package is loaded dynamically on Windows when installed; CPU fallback keeps the app runnable.
OCR_ENABLED=false
OCR_LANGUAGES=rus+eng
AI_PROVIDER=auto
DIRECTML=auto
CLIP_MODEL_PATH=
CLIP_TEXT_MODEL_PATH=
TOKENIZER_PATH=
TEXT_MAX_TOKENS=77
FACE_DETECTION_MODEL_PATH=
FACE_RECOGNITION_MODEL_PATH=
SCENE_MODEL_PATH=
BATCH_SIZE=64
NEAR_DUPLICATE_THRESHOLD=0.93

LOG_LEVEL=info
NEXT_PUBLIC_API_URL=http://localhost:4000
